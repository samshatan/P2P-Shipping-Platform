# SERVER
NODE_ENV=development
PORT=3001

# DATABASE & CACHE
DATABASE_URL=postgresql://postgres:password@localhost:5432/swiftroute
MONGODB_URL=mongodb://localhost:27017/swiftroute_tracking
REDIS_URL=redis://localhost:6379

# KAFKA (local Docker)
KAFKA_BROKERS=localhost:9092

# AUTHENTICATION
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# EMAIL (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@swiftroute.in

# STORAGE (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=evidence-vault

# MSG91 SMS
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SWFTRT

# GUPSHUP WHATSAPP
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=SwiftRoute
GUPSHUP_SOURCE_NUMBER=

# DIGIO KYC
DIGIO_BASE_URL=https://app.digio.in/api/v2
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=

# PINECONE
PINECONE_API_KEY=
PINECONE_INDEX_NAME=swiftroute-addresses

# COURIER INTEGRATIONS
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=https://staging-express.delhivery.com

# AWS (Production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=