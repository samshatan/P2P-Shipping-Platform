# SERVER
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DATABASE & CACHE
MONGODB_URL=mongodb://localhost:27017/swiftroute_tracking
REDIS_URL=redis://localhost:6379

# AUTHENTICATION
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=1d

# EMAIL (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# SHIPROCKET AGGREGATOR
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# SLACK (Alerts)
SLACK_WEBHOOK_URL=

# GUPSHUP (WhatsApp)
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=SwiftRoute
GUPSHUP_SOURCE_NUMBER=

# COURIER INTEGRATIONS
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=https://staging-express.delhivery.com

# FEATURE FLAGS
ENABLE_WORKERS=false